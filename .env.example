# Copy this file to `.env` and fill in your values:   cp .env.example .env
# `.env` is listed in .gitignore and must never be committed. This file only documents the names.
# Use it with:   uv run --env-file .env <example.py>
# (chapter 03's 07_raw_llm_call.py also reads `.env` by itself, through pydantic-settings)

# Any OpenAI-compatible API. The defaults below are a free local Ollama model:
#   ollama pull llama3.2 && ollama serve
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2

# Other free providers (uncomment one block and put your own key):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-ai-studio-key
# LLM_MODEL=gemini-2.5-flash

# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=your-groq-key
# LLM_MODEL=a-model-id-from-groq-s-model-list

# The official SDKs read these automatically when you don't pass a key:
# ANTHROPIC_API_KEY=sk-ant-your-key
# OPENAI_API_KEY=sk-your-key
